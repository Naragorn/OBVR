<!-- OBVR's "VR" button in the main menu: put into whatever main menu is loaded by MenuQue's
     InsertXML at the menu's top level (game/MainMenuVr.cpp, ui/MainMenuButton.h), so no main
     menu file is shipped or replaced. Bottom right, clear of the game's own buttons and of the
     version line at the bottom left. Shown and faded with the menu's own buttons (the main
     menu's user1 and user3). A click on it starts OBVR's start guide again; the engine's own
     click handling knows no id 9700 and does nothing with it. -->
<rect name="obvr_vr">
 <id>9700</id><target>&true;</target><locus>&true;</locus>
 <visible><copy src="MainMenu" trait="user1"/></visible>
 <width>120</width><height>45</height><depth>12</depth>
 <x><copy src="screen()" trait="width"/><sub>170</sub></x>
 <y><copy src="screen()" trait="height"/><sub>95</sub></y>
 <clicksound>1</clicksound>
 <include src="OBVR/button_highlight.xml" />
 <text name="obvr_vr_label">
  <font>3</font><string>VR</string>
  <x><copy>120</copy><sub src="me()" trait="width"/><div>2</div></x>
  <y>8</y><depth>3</depth>
  <red>233</red><green>219</green><blue>183</blue>
  <alpha><copy src="MainMenu" trait="user3"/></alpha>
 </text>
</rect>
