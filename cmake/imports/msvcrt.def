; Imports from msvcrt.dll for the SDK-free verification build.
;
; msvcrt.dll exists on every Windows and is loaded in the Oblivion process
; anyway. Every entry is cdecl and therefore carries no decoration.
LIBRARY msvcrt.dll
EXPORTS
_snprintf
_vsnprintf
atof
sin
cos
sqrt
; memcpy and memset are called by the compiler on its own as soon as structs
; are copied or zero initialised.
memcpy
memset
